{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "user": { "type": ["string", "object", "null"] },
          "createdAt": { "type": "string" }
        },
        "required": ["_id", "title", "description", "category"]
      }
    }
  },
  "required": ["data"]
}